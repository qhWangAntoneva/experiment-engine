    "phase_6_web_deployment": {
      "title": "Web 部署 — Pyodide 浏览器端运行 (Web Deployment)",
      "priority": "HIGH",
      "summary": "通过 Pyodide 将 QCA Python 引擎编译到 WebAssembly，在浏览器端运行，部署至 GitHub Pages (qhWangAntoneva.github.io/experiment-engine/)。前端 React + TypeScript 已实现 Pyodide Web Worker 桥接层、Plotly.js 可视化组件、QCA 流水线状态管理。",
      "architecture": {
        "runtime": "Pyodide v0.29.x via CDN (jsDelivr)",
        "python_packages": [
          "numpy (OK)",
          "pyyaml (OK)",
          "plotly (OK)",
          "pandas (可选)"
        ],
        "blocked_packages": [
          "pydantic>=2.0 (pydantic-core 为 Rust 二进制)",
          "matplotlib (仅 Agg 后端)",
          "click/rich (浏览器无关)"
        ],
        "frontend": "React 18 + Vite 5 + TypeScript + Plotly.js",
        "deployment": "GitHub Pages (gh-pages 分支), GitHub Actions CI/CD",
        "url": "https://qhWangAntoneva.github.io/experiment-engine/"
