    "phase_7_bert_prototype": {
      "title": "BERT + Prototype 架构重构 (BERT CLS + Cosine Similarity)",
      "priority": "CRITICAL",
      "summary": "废弃关键词识别方案，用 BERT CLS embedding + 余弦相似度实现 Prototype 理论驱动的模糊集校准。架构方案：Hybrid Transformers.js + Pyodide。模型：bert-base-chinese (ONNX int8, ~100MB)。算法：Mean Pooling + Centroid Aggregation + Softmax(tau=5.0)。",
      "architecture": {
        "bert_runtime": "Transformers.js (ONNX Runtime Web) in Web Worker",
        "embedding_model": "Xenova/bert-base-chinese (ONNX int8 quantized)",
        "cosine_engine": "Python/numpy in Pyodide (CosineSimilarityEngine)",
        "calibration": "Existing strategies (Direct/Indirect/Ragin) — unchanged",
        "qca_analysis": "QCA pipeline — unchanged",
        "new_dependency": "@xenova/transformers (npm)"
      },
