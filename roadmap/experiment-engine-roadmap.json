        },
        {
          "risk": "BERT 推理耗时过长 (500+ 文本 >30s)",
          "mitigation": "分批处理 (batch_size=32) + 进度条；Web Worker 不阻塞 UI；后续支持 WebGPU 加速",
          "severity": "MEDIUM"
        },
        {
          "risk": "浏览器内存超限 (Pyodide 50MB + BERT 100MB = 150MB+)",
          "mitigation": "BERT 模型惰性加载 (仅选择 PROTOTYPE scoring 时加载)；大文本分块处理；内存监控面板",
